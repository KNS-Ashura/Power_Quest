; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="2proj"
run/main_scene="res://scenes/menu/book-menu.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")

[autoload]

MapSession="*res://scripts/autoload/map_session.gd"
Economy="*res://scripts/autoload/economy.gd"
RegionManager="*res://scripts/autoload/region_manager.gd"
GameManager="*res://scripts/autoload/game_manager.gd"
AIManager="*res://scripts/autoload/ai_manager.gd"
Sound="*uid://c6u57jpr1208q"
ScreenAdapter="*res://scripts/autoload/screen_adapter.gd"

[display]

window/size/viewport_width=1680
window/size/viewport_height=945
window/size/mode=3
window/size/borderless=true
window/size/window_width_override=1680
window/size/window_height_override=945
window/stretch/mode="viewport"

[editor]

version_control/plugin_name="GitPlugin"
version_control/autoload_on_startup=true

[editor_plugins]

enabled=PackedStringArray()

[internationalization]

locale/translations=PackedStringArray("res://assets/menu/traduction.de.translation", "res://assets/menu/traduction.en.translation", "res://assets/menu/traduction.fr.translation")

[layer_names]

2d_physics/layer_1="world"
2d_navigation/layer_1="Nav_ground"
2d_physics/layer_2="player_units"
2d_navigation/layer_2="Nav_water"
2d_physics/layer_3="enemy_units"
2d_navigation/layer_3="ground-and-water-unit"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
