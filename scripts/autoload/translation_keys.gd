static func apply_to_server() -> int:
	var count := 0
	for loc in [{"code": "en", "msg": MSG_EN}, {"code": "fr", "msg": MSG_FR}, {"code": "de", "msg": MSG_DE}]:
		var translation := Translation.new()
		translation.locale = loc.code
		for key in loc.msg:
			translation.add_message(key, str(loc.msg[key]))
			count += 1
		TranslationServer.add_translation(translation)
	return count
